# Django Settings
SECRET_KEY=your-production-secret-key-change-me
DEBUG=False
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True

# Optional: PostgreSQL Database (leave blank to use SQLite)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# AI Provider Settings
# Option 1: Groq (Recommended for cloud deployment - 100% free at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Option 2: OpenAI (optional)
# OPENAI_API_KEY=sk-your_openai_api_key_here

# Option 3: Local LM Studio (default if no key provided, local development only)
# LM_STUDIO_URL=http://127.0.0.1:1234/v1/chat/completions
